{
  "name": "@nool-and-nila/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:pg": "prisma generate --schema=prisma-postgresql/schema.prisma",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:pg": "prisma migrate deploy --schema=prisma-postgresql/schema.prisma",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:status:pg": "prisma migrate status --schema=prisma-postgresql/schema.prisma",
    "prisma:migrate:resolve": "prisma migrate resolve",
    "prisma:drift:verify": "tsx src/scripts/verify-schema-drift.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:migrate:sqlite-to-pg": "tsx src/scripts/migrate-sqlite-to-postgres.ts",
    "db:backup": "node dist/scripts/backup.js || tsx src/scripts/backup.ts",
    "db:restore": "node dist/scripts/restore.js || tsx src/scripts/restore.ts",
    "admin:recovery": "node dist/scripts/admin-recovery.js || tsx src/scripts/admin-recovery.ts",
    "staging:rehearsal": "tsx src/scripts/staging-rehearsal.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@nool-and-nila/shared": "*",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
