# Database URL (SQLite for instant zero-dependency local dev, or PostgreSQL for staging/production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nool_and_nila?schema=public"

PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Authentication & Security
JWT_SECRET=nool_and_nila_secure_jwt_secret_token_dev_key_2026_xyz
JWT_EXPIRES_IN=7d
COOKIE_SECRET=nool_and_nila_cookie_secret_key_dev_2026

# WhatsApp Business Integration (Digits only with country code, e.g. 919876543210)
WHATSAPP_BUSINESS_NUMBER=919876543210

# Cloudinary Image Storage (Optional: Local file storage is automatically used if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
